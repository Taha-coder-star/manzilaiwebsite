# Public setting, bundled into the client. Do not put secrets here.
# Public WhatsApp link for demo requests (wa.me with an encoded text parameter).
VITE_DEMO_URL=
# Public homepage URL used for canonical and Open Graph tags.
VITE_SITE_URL=
# Approved public privacy policy URL used in the footer.
VITE_PRIVACY_URL=
# Server-only origin for the FastAPI onboarding proxy. Use HTTPS on Vercel.
ONBOARDING_API_ORIGIN=
# Expose the homepage portal link after the invite-only pilot has passed staging.
VITE_CLIENT_SIGN_IN_ENABLED=false
